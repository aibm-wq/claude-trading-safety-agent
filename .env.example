# Plantilla de configuración — copiar a .env y rellenar. NUNCA commitear .env.

# ── MetaTrader 5 (broker, cuenta DEMO recomendada para pruebas) ──
LOGIN=12345678
PASSWORD=tu_password_mt5
SERVER=TuBroker-Demo

# ── Telegram (para las notificaciones de cada ajuste de SL) ──
TELEGRAM_BOT_TOKEN=123456789:AAA-tu-token
TELEGRAM_CHAT_IDS=000000000

# ── Parámetros del trailing stop (opcional, tienen default en el script) ──
TRAILING_SYMBOL=EURUSD
TRAILING_INTERVAL_SEC=900
TRAILING_TZ=America/New_York
TRAILING_SESSION_START=9:30
TRAILING_SESSION_END=16:00
TRAILING_BUFFER_PTS=30
TRAILING_MIN_DISTANCE=20

# Ruta al ejecutable de metatrader-mcp-server si no está en el PATH
# METATRADER_MCP_EXE=C:\ruta\a\metatrader-mcp-server.exe
